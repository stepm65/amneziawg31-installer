[Unit]
Description=AmneziaWG 3.1 Console Telegram bot (long polling, no inbound port)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/awg31-bot/telegram.json

[Service]
Type=simple
User=awgbot
Group=awgbot
WorkingDirectory=/opt/awg31-panel
ExecStart=/opt/awg31-panel/.venv/bin/python3 /opt/awg31-panel/awg31bot.py
Restart=on-failure
RestartSec=10
# Exit status 2 = unreadable configuration: restarting cannot fix that.
RestartPreventExitStatus=2
StateDirectory=awg31-bot
StateDirectoryMode=0700
UMask=0077
PrivateTmp=true
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
