#!/usr/bin/env bash
# Minimal local management shell; does not offer destructive VPN operations.
set -Eeuo pipefail
[[ ${EUID} -eq 0 ]] || { echo 'Run as root: sudo awg31' >&2; exit 1; }
case "${1:-menu}" in
  status) systemctl --no-pager status awg31-panel.service; echo "Control helper: $(systemctl is-active awg31-helper.service 2>/dev/null)"; /usr/local/sbin/awg31mgr servers ;;
  restart-panel) systemctl restart awg31-panel.service; systemctl --no-pager status awg31-panel.service ;;
  logs) journalctl -u awg31-panel.service -n 100 --no-pager ;;
  nginx)
    [[ -f /usr/local/libexec/awg31/scripts/setup-nginx.sh ]] || { echo 'Nginx wizard is not installed' >&2; exit 1; }
    bash /usr/local/libexec/awg31/scripts/setup-nginx.sh --interactive
    ;;
  telegram)
    shift
    [[ -f /usr/local/libexec/awg31/scripts/setup-telegram.sh ]] || { echo 'Telegram bot files are not installed; run: sudo awg31 update' >&2; exit 1; }
    exec bash /usr/local/libexec/awg31/scripts/setup-telegram.sh "$@"
    ;;
  servers) /usr/local/sbin/awg31mgr servers ;;
  backup) /usr/local/sbin/awg31mgr backup-create ;;
  backups) /usr/local/sbin/awg31mgr backup-list ;;
  backup-policy) /usr/local/sbin/awg31mgr backup-policy </dev/null ;;
  backup-delete)
    [[ $# -eq 2 ]] || { echo 'Usage: awg31 backup-delete BACKUP_NAME' >&2; exit 2; }
    echo "Deleting this backup is irreversible: $2"
    read -r -p 'Type DELETE to proceed: ' answer
    [[ "$answer" == DELETE ]] || { echo 'Canceled'; exit 1; }
    printf '{"name":"%s"}\n' "$2" | /usr/local/sbin/awg31mgr backup-delete
    ;;
  restore-check)
    [[ $# -eq 2 ]] || { echo 'Usage: awg31 restore-check BACKUP_NAME' >&2; exit 2; }
    python3 /usr/local/libexec/awg31/scripts/restore-backup.py --check "$2" ;;
  restore)
    [[ $# -eq 2 ]] || { echo 'Usage: awg31 restore BACKUP_NAME' >&2; exit 2; }
    python3 /usr/local/libexec/awg31/scripts/restore-backup.py --check "$2"
    echo 'Restoring will replace VPN configs, databases and panel auth and restart services.'
    read -r -p 'Type RESTORE to proceed: ' answer
    [[ "$answer" == RESTORE ]] || { echo 'Canceled'; exit 1; }
    python3 /usr/local/libexec/awg31/scripts/restore-backup.py --apply "$2" ;;
  version)
    cat /opt/awg31-panel/VERSION 2>/dev/null || echo 'unknown: installed before version tracking'
    ;;
  update)
    # Optional argument: a release tag (v1.2.3) or dev-latest. Release archives
    # are SHA256-verified. The installer that does this is the copy shipped
    # with the installed (already verified) release, not a script from main.
    shift || true
    installer=/usr/local/libexec/awg31/install.sh
    if [[ ! -f "$installer" ]]; then
        installer="$(mktemp /tmp/awg31-install.XXXXXXXX)"
        trap 'rm -f -- "$installer"' EXIT
        curl -fsSL --retry 2 --connect-timeout 8 --max-time 60 \
          https://raw.githubusercontent.com/stepm65/amneziawg31-installer/main/install.sh -o "$installer" \
          || { echo 'Cannot download the installer from GitHub' >&2; exit 1; }
    fi
    # Run a private copy: the update replaces the installed file while it runs.
    runner="$(mktemp /tmp/awg31-update.XXXXXXXX)"
    cp -- "$installer" "$runner"
    bash "$runner" --upgrade "$@"; status=$?
    rm -f -- "$runner"
    exit "$status"
    ;;
  port)
    [[ $# -eq 2 && "$2" =~ ^[0-9]{1,5}$ ]] && ((10#$2 >= 1 && 10#$2 <= 65535)) ||
      { echo 'Usage: awg31 port NEW_PORT   (local TCP port of the panel, 1-65535)' >&2; exit 2; }
    new=$((10#$2))
    unit=/etc/systemd/system/awg31-panel.service
    old="$(sed -nE 's/.*--port ([0-9]+).*/\1/p' "$unit" | tail -n1)"
    [[ "$old" =~ ^[0-9]+$ ]] || { echo 'Cannot read the current port from the service unit' >&2; exit 1; }
    [[ "$new" != "$old" ]] || { echo "The panel already listens on $old"; exit 0; }
    if ss -H -ltn "sport = :$new" | grep -q .; then echo "TCP port $new is already in use" >&2; exit 1; fi
    cp -p -- "$unit" "$unit.awg31-old"
    sed -i -E "s/(--port )[0-9]+/\1$new/" "$unit"
    systemctl daemon-reload && systemctl restart awg31-panel.service
    . /usr/local/libexec/awg31/scripts/os-support.sh
    if ! awg31_wait_panel "$new" 30; then
        echo 'The panel did not start on the new port: restoring the old one' >&2
        mv -f -- "$unit.awg31-old" "$unit"
        systemctl daemon-reload && systemctl restart awg31-panel.service
        exit 1
    fi
    rm -f -- "$unit.awg31-old"
    site=/etc/nginx/conf.d/awg31-panel.conf
    if [[ -f "$site" ]] && grep -q "127.0.0.1:$old;" "$site"; then
        cp -p -- "$site" "$site.awg31-old"
        sed -i "s/127\.0\.0\.1:$old;/127.0.0.1:$new;/g" "$site"
        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx; rm -f -- "$site.awg31-old"
            echo "Nginx site updated to proxy to 127.0.0.1:$new"
        else
            mv -f -- "$site.awg31-old" "$site"
            echo "WARNING: Nginx rejected the change; edit $site by hand (proxy_pass http://127.0.0.1:$new;)" >&2
        fi
    fi
    echo "The panel now listens on 127.0.0.1:$new (was $old). Update your own reverse proxy if you use one."
    ;;
  uninstall)
    shift
    exec bash /usr/local/libexec/awg31/scripts/uninstall.sh "$@"
    ;;
  reset-password)
    # Console-only recovery: the web panel cannot call this (not in sudoers).
    [[ -t 0 ]] || { echo 'Run interactively from the server console or SSH' >&2; exit 1; }
    IFS= read -r -s -p 'New panel administrator password (12+ characters): ' first; echo
    IFS= read -r -s -p 'Repeat the new password: ' second; echo
    [[ "$first" == "$second" ]] || { echo 'Passwords do not match; nothing changed' >&2; exit 1; }
    # The password travels over stdin only, never argv or environment.
    printf '%s' "$first" | python3 -c 'import json,sys; print(json.dumps({"new_password": sys.stdin.read()}))' \
      | /usr/local/sbin/awg31mgr password-reset
    unset first second
    echo 'Password changed. All existing panel sessions were signed out.'
    ;;
  totp-off)
    # Console-only recovery for a lost authenticator: not reachable from the panel.
    /usr/local/sbin/awg31mgr totp-reset </dev/null >/dev/null
    echo 'Two-factor sign-in is off. All panel sessions were signed out; the password is unchanged.'
    ;;
  backup-encryption)
    case "${2:-status}" in
      status) /usr/local/sbin/awg31mgr backup-encryption </dev/null ;;
      off)
        echo 'New backups will be stored unencrypted. Existing .gpg archives still need their passphrase.'
        if [[ "${AWG31_UNATTENDED:-0}" != 1 ]]; then
            read -r -p 'Type OFF to proceed: ' answer
            [[ "$answer" == OFF ]] || { echo 'Canceled'; exit 1; }
        fi
        echo '{"off": true}' | /usr/local/sbin/awg31mgr backup-encryption-set >/dev/null
        echo 'Backup encryption is off.'
        ;;
      on)
        phrase="${AWG31_BACKUP_PASSPHRASE:-}"
        if [[ -z "$phrase" && -t 0 ]]; then
            echo 'Backups will be encrypted with a passphrase (OpenPGP, AES-256).'
            echo 'To restore on another server you enter the same passphrase there with this command.'
            IFS= read -r -s -p 'Passphrase, 16+ characters (Enter = generate one): ' phrase; echo
            if [[ -n "$phrase" ]]; then
                IFS= read -r -s -p 'Repeat the passphrase: ' again; echo
                [[ "$phrase" == "$again" ]] || { echo 'Passphrases do not match; nothing changed' >&2; exit 1; }
            fi
        fi
        # The passphrase travels over stdin only, never argv.
        reply="$(printf '%s' "$phrase" | python3 -c 'import json,sys; print(json.dumps({"passphrase": sys.stdin.read()}))' \
                 | /usr/local/sbin/awg31mgr backup-encryption-set)"
        unset phrase again
        generated="$(printf '%s' "$reply" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("passphrase") or "")')"
        echo 'Backup encryption is on: new archives are .tar.gz.gpg.'
        if [[ -n "$generated" ]]; then
            echo
            echo "  Passphrase:  $generated"
            echo
            echo 'Write it down NOW and keep it away from this server. It is not shown again,'
            echo 'and without it an encrypted backup cannot be restored on a new server.'
        fi
        echo 'Decrypt anywhere:  gpg -d awg31-....tar.gz.gpg > backup.tar.gz'
        ;;
      change)
        echo 'A new passphrase replaces the current one; every backup the current one opens is re-encrypted.'
        phrase="${AWG31_BACKUP_PASSPHRASE:-}"
        if [[ -z "$phrase" && -t 0 ]]; then
            IFS= read -r -s -p 'New passphrase, 16+ characters (Enter = generate one): ' phrase; echo
            if [[ -n "$phrase" ]]; then
                IFS= read -r -s -p 'Repeat the passphrase: ' again; echo
                [[ "$phrase" == "$again" ]] || { echo 'Passphrases do not match; nothing changed' >&2; exit 1; }
            fi
        fi
        reply="$(printf '%s' "$phrase" | python3 -c 'import json,sys; print(json.dumps({"passphrase": sys.stdin.read()}))' \
                 | /usr/local/sbin/awg31mgr backup-encryption-change)"
        unset phrase again
        printf '%s' "$reply" | python3 -c '
import json, sys
r = json.load(sys.stdin)
print("Passphrase changed; backups re-encrypted:", r["reencrypted"])
if r["skipped"]:
    print("NOT re-encrypted (sealed with an earlier passphrase, they still need that one):")
    for name in r["skipped"]: print("  " + name)
if r.get("passphrase"):
    print("\n  Passphrase:  " + r["passphrase"] + "\n\nWrite it down NOW and keep it away from this server. It is not shown again.")
print("Copies already sent to Telegram or a remote storage keep the OLD passphrase.")'
        ;;
      *) echo 'Usage: awg31 backup-encryption [status|on|off|change]' >&2; exit 2 ;;
    esac
    ;;
  backup-remote)
    ask_value(){ # ask_value VARIABLE 'Prompt' [default]; unattended: AWG31_REMOTE_<VARIABLE>
        local name="AWG31_REMOTE_$1" value
        value="${!name:-}"
        if [[ -z "$value" && -t 0 ]]; then read -r -p "$2${3:+ [$3]}: " value; fi
        printf '%s' "${value:-${3:-}}"
    }
    case "${2:-status}" in
      status) /usr/local/sbin/awg31mgr backup-remote </dev/null ;;
      test) /usr/local/sbin/awg31mgr backup-remote-test </dev/null && echo 'The storage accepted a test file.' ;;
      off)
        echo '{"off": true}' | /usr/local/sbin/awg31mgr backup-remote-set >/dev/null
        echo 'Remote storage is off. Files already uploaded stay where they are.'
        ;;
      s3)
        echo 'S3-compatible storage (AWS S3, MinIO, Backblaze B2, Yandex Object Storage, ...). Only encrypted backups are uploaded.'
        endpoint="$(ask_value ENDPOINT 'Endpoint URL' 'https://s3.amazonaws.com')"
        region="$(ask_value REGION 'Region' 'us-east-1')"
        bucket="$(ask_value BUCKET 'Bucket name')"
        prefix="$(ask_value PREFIX 'Folder inside the bucket, ending with / (empty = none)' '')"
        access="$(ask_value ACCESS_KEY 'Access key ID')"
        secret="${AWG31_REMOTE_SECRET_KEY:-}"
        if [[ -z "$secret" && -t 0 ]]; then IFS= read -r -s -p 'Secret access key (hidden): ' secret; echo; fi
        # Values travel as JSON over stdin, never in argv.
        E="$endpoint" G="$region" B="$bucket" P="$prefix" A="$access" S="$secret" python3 -c '
import json, os
e = os.environ
print(json.dumps({"type": "s3", "endpoint": e["E"], "region": e["G"], "bucket": e["B"], "prefix": e["P"], "access_key": e["A"], "secret_key": e["S"]}))' \
          | /usr/local/sbin/awg31mgr backup-remote-set >/dev/null
        unset secret
        /usr/local/sbin/awg31mgr backup-remote-test </dev/null >/dev/null && echo 'Storage saved and tested: every new backup is uploaded there.' \
          || { echo 'Storage saved, but the test upload FAILED (see the error above). Fix the values and run the command again.' >&2; exit 1; }
        ;;
      sftp)
        echo 'SFTP server. Only encrypted backups are uploaded; the server gets its own SSH key for this.'
        host="$(ask_value HOST 'Host name or IP')"
        port="$(ask_value PORT 'SSH port' '22')"
        user="$(ask_value USER 'User name')"
        path="$(ask_value PATH 'Directory on the server (absolute)' '/')"
        reply="$(H="$host" O="$port" U="$user" D="$path" python3 -c '
import json, os
e = os.environ
print(json.dumps({"type": "sftp", "host": e["H"], "port": e["O"], "user": e["U"], "path": e["D"]}))' | /usr/local/sbin/awg31mgr backup-remote-set)"
        echo "Add this public key to ~/.ssh/authorized_keys of $user on $host:"
        echo
        printf '%s' "$reply" | python3 -c 'import json,sys; print("  " + json.load(sys.stdin)["public_key"])'
        echo
        if [[ -t 0 && "${AWG31_UNATTENDED:-0}" != 1 ]]; then read -r -p 'Press Enter when the key is added to test the upload... ' _; fi
        /usr/local/sbin/awg31mgr backup-remote-test </dev/null >/dev/null && echo 'Storage saved and tested: every new backup is uploaded there.' \
          || { echo 'Storage saved, but the test upload FAILED (see the error above). After adding the key run: sudo awg31 backup-remote test' >&2; exit 1; }
        ;;
      *) echo 'Usage: awg31 backup-remote [status|s3|sftp|test|off]' >&2; exit 2 ;;
    esac
    ;;
  doctor) bash /usr/local/libexec/awg31/scripts/kernel-check.sh; /usr/local/sbin/awg31mgr diagnostics ;;

  *)
    cat <<'MENU'
AmneziaWG 3.1 local management
  sudo awg31 status          Show panel and VPN instances
  sudo awg31 servers         List configured VPN interfaces
  sudo awg31 backups         List root-owned backup archives
  sudo awg31 backup          Create a full backup archive
  sudo awg31 backup-policy   Show current automated backup schedule
  sudo awg31 backup-delete NAME  Delete an archive after confirmation
  sudo awg31 restore-check NAME  Verify checksums and SQLite of a backup
  sudo awg31 restore NAME    Restore after confirmation (VPN downtime)
  sudo awg31 doctor          Check kernel/DKMS and interface
  sudo awg31 update [VER]    Update panel and controller (latest release, vX.Y.Z or dev-latest)
  sudo awg31 version         Show the installed version
  sudo awg31 reset-password  Set a new panel password (forgotten password)
  sudo awg31 totp-off        Turn off two-factor sign-in (lost authenticator)
  sudo awg31 backup-encryption on|off|status|change  Encrypt backups with a passphrase
  sudo awg31 backup-remote s3|sftp|test|status|off  Upload every new backup to S3 or SFTP
  sudo awg31 port NEW_PORT   Change the local TCP port of the panel
  sudo awg31 uninstall       Remove the console (add --purge to delete VPN data too)
  sudo awg31 restart-panel   Restart web panel only
  sudo awg31 logs            View panel logs
  sudo awg31 nginx           Configure optional Nginx HTTPS (safe for existing VPN)
  sudo awg31 telegram        Connect the Telegram bot (also: telegram status | test | off)

  Panel listens on 127.0.0.1. HTTPS is optional; use sudo awg31 nginx to configure it.
  VPN server configuration is managed through the authenticated web panel.
MENU
    ;;
esac
