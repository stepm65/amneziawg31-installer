def client_import_row(con):
    """A client moved from another server: same keys, owner, limits and subscription; a new address here."""
    row = read_json().get('row')
    if not isinstance(row, dict) or set(row) != set(MOVE_KEEP): raise ValueError('Неполная запись клиента')
    name = str(row['name'])
    if not NAME_RE.fullmatch(name): raise ValueError('Неверное имя клиента')
    if con.execute('SELECT 1 FROM clients WHERE name=?', (name,)).fetchone():
        raise ValueError(f'На сервере {IFACE} уже есть клиент {name}')
    if con.execute('SELECT 1 FROM clients WHERE public_key=?', (row['public_key'],)).fetchone():
        raise ValueError(f'На сервере {IFACE} уже есть клиент с этим ключом')
    cfg = get_settings(con)
    routes = parse_routes(row['routed_subnets'], cfg, con, owner=name)
    cps = validate_i_fields({'i_enabled': str(int(row['i_enabled'])), **{k: row[k] for k in I_KEYS}})
    extra = validate_extra_lines(row['extra_lines'])
    used = {x['ip'] for x in peer_rows(con)}
    address = next((str(h) for h in list(parse_network(cfg['subnet']).hosts())[1:] if str(h) not in used), None)
    if address is None: raise ValueError(f'На сервере {IFACE} нет свободных адресов')
    values = {**row, 'ip': address, 'routed_subnets': routes, 'extra_lines': extra, **cps}
    columns = (*MOVE_KEEP, 'ip')
    con.execute(f'INSERT INTO clients ({",".join(columns)}) VALUES ({",".join("?" * len(columns))})',
                [values[c] for c in columns])
    apply(cfg, con)
    con.commit()
    return {'ok': True, 'name': name, 'ip': address, 'interface': IFACE}


def client_network_update(con):
    data = read_json()
    name = str(data.get('name', ''))
    if not NAME_RE.fullmatch(name): raise ValueError('Invalid client name')
    row = con.execute('SELECT * FROM clients WHERE name=?', (name,)).fetchone()
    if not row: raise ValueError('Client not found')
    cfg = get_settings(con)
    address = validate_client_address(data.get('ip', row['ip']), cfg, con, name)
    routes = parse_routes(data.get('routed_subnets',''),cfg,con,owner=name)
    cps = validate_i_fields(data,dict(row))
    address_changed = row['ip'] != address
    routes_changed = row['routed_subnets'] != routes
    cps_changed = any(row[key] != cps[key] for key in I_KEYS) or int(row['i_enabled']) != cps['i_enabled']
    extra = validate_extra_lines(data['extra_lines']) if 'extra_lines' in data else row['extra_lines']
    if address_changed or routes_changed or cps_changed or extra != row['extra_lines']:
        peer_backup(con, name)
    con.execute('''UPDATE clients SET ip=?, routed_subnets=?, i_enabled=?,
                   i1=?,i2=?,i3=?,i4=?,i5=?, extra_lines=? WHERE name=?''',
                (address,routes,cps['i_enabled'],*(cps[key] for key in I_KEYS),extra,name))
    if address_changed or routes_changed:
        apply(cfg,con)  # sync peer AllowedIPs and reconcile routes without a forced restart
    con.commit()
    return {'ok':True,'name':name,'ip':address,'routed_subnets':routes,'reimport_client':True}


def settings_update(con):
    old = get_settings(con)
    request = read_json()
    new = validate_settings(request, old=old)
    obf = validate_obfuscation(request, {**old,**new})
    old_mode = old['mode']
    # A changed route mode changes all exported configs; clients must reimport.
    switches = {}
    for name in SWITCHES:
        value = str(request.get(name, switch(old, name))).lower()
        if value not in ('on', 'off'):
            raise ValueError(f'{name}: expected on or off')
        switches[name] = value
    dns = ipaddress.ip_address(new['dns'])
    if (old_mode == 'full' and switches['private_access'] == 'off' and dns.is_private
            and dns not in ipaddress.ip_network(old['subnet'])):
        raise ValueError('DNS клиентов находится в частной сети: оставьте доступ к частным сетям включённым или укажите публичный DNS')
    if switches['use_domain'] == 'on' and not new['endpoint_domain']:
        raise ValueError('Чтобы клиенты подключались по домену, укажите домен сервера')
    cfg = {**old, **new, **obf, **switches}
    stored = {**new, **obf, **switches}
    stored['header_key'] = obf['header_key']
    # Refuse mode change to avoid PostDown from the old mode being skipped at restart.
    if new['mode'] != old_mode or new['uplink'] != old['uplink']:
        raise ValueError('Смена режима маршрутизации/интерфейса после установки пока запрещена')
    # Save durable recovery copies before replacing any live config.
    backup = SETTINGS_BACKUPS / (
        datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')+'-'+IFACE+'-'+secrets.token_hex(3))
    backup.mkdir(parents=True,mode=0o700,exist_ok=False)
    os.chmod(backup,0o700)
    if CONF.exists():
        shutil.copy2(CONF,backup/'server.conf')
        os.chmod(backup/'server.conf',0o600)
    with sqlite3.connect(backup/'state.sqlite3') as destination:
        con.backup(destination)
    os.chmod(backup/'state.sqlite3',0o600)
    peers = peer_rows(con)
    before = {p['name']: config_fingerprint(client_config(old, p, peers)) for p in peers}
    put_settings(con, stored)
    apply(cfg, con, restart=True)
    con.commit()
    after = get_settings(con)
    changed = [p['name'] for p in peers if config_fingerprint(client_config(after, p, peers)) != before[p['name']]]
    return {'ok':True,'reimport_clients':bool(changed),'configs_changed':len(changed),'backup':str(backup),
            'domain_warning':domain_check(after)}


def logging_settings():
    try: data = json.loads(LOGGING.read_text())
    except (OSError, ValueError): data = {}
    result = {'history': False, 'retention_days': 30, 'masking': 'partial'}
    if isinstance(data, dict):
        result['history'] = bool(data.get('history', False))
        try: result['retention_days'] = min(365, max(1, int(data.get('retention_days', 30))))
        except (TypeError, ValueError): pass
        if data.get('masking') in ('none', 'partial', 'full'): result['masking'] = data['masking']
    return result


def mask_endpoint(endpoint, mode):
    '''A client's public address as the history keeps it. "full" never stores the address itself.'''
    host = endpoint.rsplit(':', 1)[0].strip('[]') if endpoint.count(':') == 1 or endpoint.startswith('[') else endpoint
    try: address = ipaddress.ip_address(host)
    except ValueError: return ''
    if mode == 'none': return endpoint
    if mode == 'partial':
        if address.version == 4: return '.'.join(host.split('.')[:3]) + '.x'
        return ':'.join(address.exploded.split(':')[:3]) + ':…'
    try: key = MASK_KEY.read_bytes()
    except FileNotFoundError:
        key = secrets.token_bytes(32)
        try:
            fd = os.open(MASK_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            try: os.write(fd, key)
            finally: os.close(fd)
        except FileExistsError: key = MASK_KEY.read_bytes()
    import hmac
    return 'IP-' + hmac.new(key, address.packed, hashlib.sha256).hexdigest()[:6]


def track_sessions(con, moved, instant):
    '''One row per connection: opened by a fresh handshake, closed when handshakes stop or the address changes.'''
    settings = logging_settings()
    if settings['history']:
        open_rows = {r['client']: dict(r) for r in con.execute('SELECT * FROM sessions WHERE ended=0')}
        for name, (live, delta_r, delta_t) in moved.items():
            current = open_rows.pop(name, None)
            handshake = int((live or {}).get('handshake') or 0)
            online = bool(live) and handshake and instant - handshake <= ONLINE_SECONDS
            address = mask_endpoint((live or {}).get('endpoint', ''), settings['masking']) if online else ''
            if current and (not online or (address and current['address'] and address != current['address'])):
                con.execute('UPDATE sessions SET ended=? WHERE id=?', (max(current['last_seen'], current['started']), current['id']))
                current = None
            if not online: continue
            if current:
                con.execute('UPDATE sessions SET last_seen=?, rx=rx+?, tx=tx+?, address=? WHERE id=?',
                            (max(handshake, current['last_seen']), delta_r, delta_t, address or current['address'], current['id']))
            else:
                con.execute('INSERT INTO sessions(client, started, last_seen, address, rx, tx) VALUES(?,?,?,?,?,?)',
                            (name, min(handshake, instant), handshake, address, delta_r, delta_t))
        for current in open_rows.values():        # deleted clients
            con.execute('UPDATE sessions SET ended=? WHERE id=?', (current['last_seen'], current['id']))
    else:
        con.execute('UPDATE sessions SET ended=last_seen WHERE ended=0')
    con.execute('DELETE FROM sessions WHERE ended>0 AND ended<?', (instant - settings['retention_days'] * 86400,))


def client_sessions(con):
    data = read_json()
    name = str(data.get('name', ''))
    if not con.execute('SELECT 1 FROM clients WHERE name=?', (name,)).fetchone(): raise ValueError('Клиент не найден')
    try: limit = min(500, max(1, int(data.get('limit', 50))))
    except (TypeError, ValueError): limit = 50
    rows = [dict(r) for r in con.execute('SELECT started, last_seen, ended, address, rx, tx FROM sessions WHERE client=? '
                                         'ORDER BY started DESC, id DESC LIMIT ?', (name, limit))]
    settings = logging_settings()
    return {'name': name, 'sessions': rows, 'history': settings['history'], 'retention_days': settings['retention_days'],
            'masking': settings['masking']}


def live_stats():
    try: output = run('awg', 'show', IFACE, 'dump')
    except Exception: return {}
    stats = {}
    for line in output.splitlines()[1:]:
        parts = line.split('\t')
        if len(parts) >= 8:
            stats[parts[0]] = {'endpoint':parts[2] if parts[2] != '(none)' else '',
                               'handshake':int(parts[4]) if parts[4].isdigit() else 0,
                               'received':int(parts[5]) if parts[5].isdigit() else 0,
                               'sent':int(parts[6]) if parts[6].isdigit() else 0}
    return stats


def get_status(con, with_clients=False):
    cfg = get_settings(con)
    result = {k:cfg[k] for k in ('subnet','server_ip','port','mtu','dns','endpoint','mode','uplink','public_key')}
    result['endpoint_domain'] = cfg.get('endpoint_domain', '')
    result['client_host'] = client_host(cfg)
    for name in SWITCHES:
        result[name] = switch(cfg, name)
    # Only authenticated dashboard receives this, never the public traffic API.
    result['obfuscation'] = {k:cfg.get(k) for k in ('Jc','Jmin','Jmax',*S_KEYS,*H_KEYS,
                  'ContentPaddingAddition','RandomTrailers','DisableCookies',*TIMING_KEYS)}
    result['obfuscation']['HeaderProtectionKey'] = cfg['header_key']
    result['interface'] = IFACE
    result['running'] = subprocess.run(['ip','link','show',IFACE],capture_output=True).returncode==0
    result['mask_profile'] = cfg.get('mask_profile', 'none')
    result['mask_i1'] = cfg.get('mask_i1', '') if result['mask_profile'] == 'custom' else ''
    try: watch_minutes = int(cfg.get('watch_minutes', 30) or 0)
    except ValueError: watch_minutes = 0
    result['watch'] = {'minutes': watch_minutes, 'rotate': cfg.get('watch_rotate', 'off'), 'state': cfg.get('watch_state', 'ok'),
                       'seen': int(cfg.get('watch_seen') or 0), 'count': int(cfg.get('watch_count') or 0)}
    result['rotation'] = {'days': int(cfg.get('rotate_days') or 0), 'parts': str(cfg.get('rotate_parts') or 'port,obfuscation').split(','),
                          'rotated_at': cfg.get('rotated_at', ''), 'since': cfg.get('rotate_since', '')}
    if with_clients:
        stats = live_stats()
        peers = peer_rows(con)
        result['clients'] = [
            {k:p[k] for k in ('name','ip','public_key','enabled','created_at','routed_subnets','i_enabled','comment','expires_at','traffic_limit_bytes','used_bytes','disabled_reason','last_handshake','telegram_id','owner_export','speed_limit_mbit','speed_up_mbit','quota_period','group_name')}
            | {'extra_lines': bool(p.get('extra_lines')), 'subscription': bool(p.get('sub_hash')),
               'sub_last_fetch': p.get('sub_last_fetch', ''),
               'stats': (stats.get(p['public_key']) or {'handshake':p['last_handshake'],'received':p['last_rx'],'sent':p['last_tx']}),
               # True when the configuration handed out earlier no longer matches the server.
               'config_stale': bool(p.get('exported_hash')) and p['exported_hash'] != config_fingerprint(client_config(cfg,p,peers))}
            for p in peers]
    return result


def main():
    if os.geteuid() != 0: raise PermissionError('Контроллер требует root')
    if len(sys.argv) != 2 or sys.argv[1] not in ('init','status','list','add','download','enable','disable','delete','delete-batch','client-network','client-extra','client-policy','settings','sample','history','add-batch','sessions',
                                                    'client-rekey','client-batch','client-invite','invite-redeem',
                                                    'sub-token','sub-fetch','rotate','rotate-schedule','mask-apply','probe',
                                                    'client-export','client-import','watch-set'):
        raise ValueError('Неподдерживаемая команда')
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    if sys.argv[1] == 'probe':
        # Only the settings are read under the lock: the panel stays usable while the check listens.
        data = read_json()
        with open(LOCK, 'a+') as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            con = get_conn()
            try: cfg = get_settings(con)
            finally: con.close()
        print(json.dumps(probe_port(cfg, data), ensure_ascii=False))
        return
    with open(LOCK,'a+') as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        op = sys.argv[1]
        if op == 'init': result = init()
        else:
            con = get_conn()
            try:
                if op == 'status': result = get_status(con)
                elif op == 'list': result = get_status(con, True)
                elif op == 'add': result = clients_add(con)
                elif op == 'add-batch': result = clients_add_batch(con)
                elif op == 'client-network': result = client_network_update(con)
                elif op == 'client-extra': result = client_extra_update(con)
                elif op == 'client-rekey': result = client_rekey(con)
                elif op == 'client-batch': result = client_batch(con)
                elif op == 'client-invite': result = client_invite(con)
                elif op == 'invite-redeem': result = invite_redeem(con)
                elif op == 'sub-token': result = subscription_token(con)
                elif op == 'sub-fetch': result = subscription_fetch(con)
                elif op == 'rotate': result = rotate_op(con)
                elif op == 'rotate-schedule': result = rotate_schedule(con)
                elif op == 'mask-apply': result = mask_apply(con)
                elif op == 'client-export': result = client_export_row(con)
                elif op == 'client-import': result = client_import_row(con)
                elif op == 'watch-set': result = watch_set(con)
                elif op == 'client-policy': result = client_policy_update(con)
                elif op == 'sample': result = sample_usage(con)
                elif op == 'history': result = traffic_history(con,read_json())
                elif op == 'sessions': result = client_sessions(con)
                elif op == 'settings': result = settings_update(con)
                elif op == 'delete-batch': result = clients_delete_batch(con)
                else: result = clients_action(con, op)
            finally: con.close()
        print(json.dumps(result,ensure_ascii=False))


if __name__=='__main__':
    try: main()
    except (ValueError,RuntimeError,sqlite3.Error,OSError,subprocess.TimeoutExpired,PermissionError) as exc:
        print(json.dumps({'error':str(exc)},ensure_ascii=False),file=sys.stderr)
        sys.exit(1)
