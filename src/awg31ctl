def subscription_fetch(con):
    """A router asks for its configuration: the current .conf (with its extra lines) and its fingerprint."""
    data = read_json()
    token = str(data.get('token', ''))
    if not SUB_RE.fullmatch(token): raise ValueError('Invalid token')
    row = con.execute('SELECT * FROM clients WHERE sub_hash=?', (sub_digest(token),)).fetchone()
    if not row:
        return {'found': False}
    row = dict(row)
    if not row['enabled']:
        return {'found': True, 'enabled': False, 'name': row['name']}
    cfg = get_settings(con)
    conf = client_config(cfg, row, peer_rows(con))
    fingerprint = config_fingerprint(conf)
    address = mask_endpoint(str(data.get('addr', '')), logging_settings()['masking']) if data.get('addr') else ''
    # A router that fetched the configuration has the current one: it is no longer stale.
    con.execute('UPDATE clients SET sub_last_fetch=?, sub_last_addr=?, sub_fetches=sub_fetches+1, exported_hash=? WHERE name=?',
                (datetime.now(timezone.utc).isoformat(timespec='seconds'), address, fingerprint, row['name']))
    con.commit()
    return {'found': True, 'enabled': True, 'name': row['name'], 'config': conf, 'etag': fingerprint[:32]}


def used_udp_ports():
    ports = set()
    for conf in CONF.parent.glob('*.conf'):
        try:
            found = re.search(r'^\s*ListenPort\s*=\s*([0-9]+)', conf.read_text(), re.M)
        except OSError:
            continue
        if found: ports.add(int(found.group(1)))
    cp = subprocess.run(['ss', '-Hlun'], capture_output=True, text=True, check=False)
    for line in cp.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 4:
            port = parts[3].rsplit(':', 1)[-1]
            if port.isdigit(): ports.add(int(port))
    return ports


def pick_port(current):
    used = used_udp_ports() | {current}
    for _ in range(200):
        port = 20000 + secrets.randbelow(40000)
        if port not in used: return port
    raise RuntimeError('Не нашлось свободного UDP-порта')


def host_firewall_port(new, old):
    """Open the new UDP port in an active ufw or firewalld (and close the old one). A cloud firewall stays the admin's job."""
    if new == old: return ''
    if shutil.which('ufw') and 'Status: active' in subprocess.run(['ufw', 'status'], capture_output=True, text=True).stdout:
        subprocess.run(['ufw', 'allow', f'{new}/udp'], capture_output=True, check=False)
        subprocess.run(['ufw', 'delete', 'allow', f'{old}/udp'], capture_output=True, check=False)
        return 'ufw'
    if shutil.which('firewall-cmd') and subprocess.run(['systemctl', 'is-active', '--quiet', 'firewalld']).returncode == 0:
        subprocess.run(['firewall-cmd', '--permanent', f'--add-port={new}/udp'], capture_output=True, check=False)
        subprocess.run(['firewall-cmd', '--permanent', f'--remove-port={old}/udp'], capture_output=True, check=False)
        subprocess.run(['firewall-cmd', '--reload'], capture_output=True, check=False)
        return 'firewalld'
    return ''


def settings_backup(con, label):
    backup = SETTINGS_BACKUPS / (
        datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S') + '-' + IFACE + '-' + label + '-' + secrets.token_hex(3))
    backup.mkdir(parents=True, mode=0o700, exist_ok=False)
    os.chmod(backup, 0o700)
    if CONF.exists():
        shutil.copy2(CONF, backup / 'server.conf')
        os.chmod(backup / 'server.conf', 0o600)
    with sqlite3.connect(backup / 'state.sqlite3') as destination:
        con.backup(destination)
    os.chmod(backup / 'state.sqlite3', 0o600)
    return backup


def rotate(con, parts, reason='manual'):
    """New port, obfuscation and/or server key in one restart. Client names, addresses, keys and limits stay."""
    parts = [p for p in ROTATE_PARTS if p in parts]
    if not parts: raise ValueError('Выберите, что сменить: порт, обфускацию или ключ сервера')
    cfg = get_settings(con)
    old_port = cfg['port']
    stored = {}
    if 'port' in parts:
        stored['port'] = pick_port(old_port)
    if 'obfuscation' in parts:
        fresh = fresh_obfuscation()
        # The admin's choices about trailers, cookies and padding stay as they were.
        for keep in ('RandomTrailers', 'DisableCookies', 'ContentPaddingAddition', 'Jmin', 'Jmax', *TIMING_KEYS):
            fresh[keep] = cfg.get(keep, fresh[keep])
        stored.update(fresh)
    if 'key' in parts:
        stored['private_key'] = keygen()
        stored['public_key'] = pubkey(stored['private_key'])
    stored['rotated_at'] = datetime.now(timezone.utc).isoformat(timespec='seconds')
    settings_backup(con, 'rotate')
    put_settings(con, stored)
    rekeyed = []
    if 'client_keys' in parts:
        # Only routers with a subscription: they fetch the new keys by themselves.
        for (name,) in con.execute("SELECT name FROM clients WHERE sub_hash<>'' ORDER BY name").fetchall():
            private = keygen()
            con.execute('UPDATE clients SET private_key=?, public_key=?, psk=?, last_rx=0, last_tx=0 WHERE name=?',
                        (private, pubkey(private), pskgen(), name))
            rekeyed.append(name)
    cfg = get_settings(con)
    apply(cfg, con, restart=True)
    con.commit()
    firewall = host_firewall_port(cfg['port'], old_port)
    return {'ok': True, 'parts': parts, 'reason': reason, 'port': cfg['port'], 'old_port': old_port,
            'firewall': firewall, 'reimport_clients': True, 'clients_rekeyed': rekeyed}


def rotate_op(con):
    data = read_json()
    parts = data.get('parts')
    if not isinstance(parts, list) or not all(p in ROTATE_PARTS for p in parts):
