def sub_digest(token):
    return hashlib.sha256(('awg31-sub:' + token).encode()).hexdigest()


def subscription_token(con):
    """Create (or replace) or revoke a client's subscription token; the token is shown once."""
    data = read_json()
    name = str(data.get('name', ''))
    if not NAME_RE.fullmatch(name): raise ValueError('Неверное имя клиента')
    if not con.execute('SELECT 1 FROM clients WHERE name=?', (name,)).fetchone(): raise ValueError('Клиент не найден')
    if data.get('action') == 'revoke':
        con.execute("UPDATE clients SET sub_hash='', sub_created='' WHERE name=?", (name,))
        con.commit()
        return {'ok': True, 'name': name}
    token = secrets.token_urlsafe(32)                    # 43 characters, 256 bits
    con.execute("UPDATE clients SET sub_hash=?, sub_created=?, sub_last_fetch='', sub_last_addr='', sub_fetches=0 WHERE name=?",
                (sub_digest(token), datetime.now(timezone.utc).isoformat(timespec='seconds'), name))
