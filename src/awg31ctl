    return {'ok': True, 'name': name, 'config': client_config(cfg, row, peer_rows(con)), 'reimport_client': True}


def utc_now():
    return datetime.now(timezone.utc)


def client_batch(con):
    """The same change for a selection: enable, disable, extend the term, set the traffic limit.
    Clients the change cannot apply to are reported, not failed."""
    data = read_json()
    names = read_names(data)
    action = str(data.get('action', ''))
    if action not in ('enable', 'disable', 'extend', 'limit', 'group'):
        raise ValueError('action: enable, disable, extend, limit или group')
    days = limit = 0
    group = valid_group(data.get('group', '')) if action == 'group' else ''
    if action == 'extend':
        try: days = int(data.get('days', 0))
        except (TypeError, ValueError): raise ValueError('Продление: целое число дней') from None
        if not 1 <= days <= 3650: raise ValueError('Продление: от 1 до 3650 дней')
    if action == 'limit':
        try: limit = int(data.get('traffic_limit_bytes', -1))
        except (TypeError, ValueError): raise ValueError('Лимит трафика должен быть числом байт') from None
        if not 0 <= limit <= 10**15: raise ValueError('Недопустимый лимит трафика')
    rows = {r['name']: dict(r) for r in con.execute(
        'SELECT * FROM clients WHERE name IN (' + ','.join('?' for _ in names) + ')', names)}
    if set(rows) != set(names):
        raise ValueError('One or more clients no longer exist')
    cfg = get_settings(con)
    now = utc_now()
    changed, enabled, disabled, skipped = [], [], [], {}

    def expired(row):
        return bool(row['expires_at']) and datetime.fromisoformat(row['expires_at']) <= now

    def over_quota(row):
        return bool(row['traffic_limit_bytes']) and int(row['used_bytes']) >= int(row['traffic_limit_bytes'])

    def try_enable(row):
        if expired(row): return 'expired'
        if over_quota(row): return 'quota'
        try: parse_routes(row['routed_subnets'], cfg, con, owner=row['name'])
        except ValueError: return 'routes'
        con.execute("UPDATE clients SET enabled=1, disabled_reason='' WHERE name=?", (row['name'],))
        row['enabled'] = 1
        return ''

    for name in names:
        row = rows[name]
        if action == 'disable':
            if not row['enabled']:
                skipped[name] = 'already'; continue
            con.execute("UPDATE clients SET enabled=0, disabled_reason='manual' WHERE name=?", (name,))
            disabled.append(name); changed.append(name)
        elif action == 'enable':
            if row['enabled']:
                skipped[name] = 'already'; continue
            reason = try_enable(row)
            if reason: skipped[name] = reason
            else: enabled.append(name); changed.append(name)
        elif action == 'extend':
            if not row['expires_at']:
                skipped[name] = 'no_expiry'; continue          # without a term the client is already unlimited
            current = datetime.fromisoformat(row['expires_at'])
            when = (max(current, now) + timedelta(days=days)).replace(hour=23, minute=59, second=59, microsecond=0)
            row['expires_at'] = when.isoformat()
            con.execute('UPDATE clients SET expires_at=? WHERE name=?', (row['expires_at'], name))
            changed.append(name)
            if not row['enabled'] and row['disabled_reason'] == 'expired' and not try_enable(row):
                enabled.append(name)
        elif action == 'group':
            if row['group_name'] == group:
                skipped[name] = 'already'; continue
            con.execute('UPDATE clients SET group_name=? WHERE name=?', (group, name))
            changed.append(name)
        elif action == 'limit':
            row['traffic_limit_bytes'] = limit
            con.execute('UPDATE clients SET traffic_limit_bytes=? WHERE name=?', (limit, name))
            changed.append(name)
            if not row['enabled'] and row['disabled_reason'] == 'quota' and not try_enable(row):
                enabled.append(name)
    if enabled or disabled:
        apply(cfg, con)
    con.commit()
    return {'ok': True, 'action': action, 'changed': changed, 'enabled': enabled, 'disabled': disabled, 'skipped': skipped}


INVITE_RE = re.compile(r'^[A-Za-z0-9_-]{20,64}$')


def invite_digest(code):
    return hashlib.sha256(code.encode()).hexdigest()


def client_invite(con):
    """Create or revoke a one-time Telegram invitation for a client. The code is shown once."""
    data = read_json()
    name = str(data.get('name', ''))
    if not NAME_RE.fullmatch(name): raise ValueError('Неверное имя клиента')
    if not con.execute('SELECT 1 FROM clients WHERE name=?', (name,)).fetchone(): raise ValueError('Клиент не найден')
    if data.get('action') == 'revoke':
        con.execute("UPDATE clients SET invite_hash='', invite_expires='', invite_export=0 WHERE name=?", (name,))
        con.commit()
        return {'ok': True, 'name': name}
    try: days = int(data.get('days', 7))
    except (TypeError, ValueError): raise ValueError('Срок приглашения: целое число дней') from None
    if not 1 <= days <= 30: raise ValueError('Срок приглашения: от 1 до 30 дней')
    export = data.get('export') in (True, 1, '1', 'true', 'on')
    code = secrets.token_urlsafe(18)                     # 24 characters, allowed in t.me/<bot>?start=
    expires = (utc_now() + timedelta(days=days)).replace(microsecond=0).isoformat()
    con.execute('UPDATE clients SET invite_hash=?, invite_expires=?, invite_export=? WHERE name=?',
                (invite_digest(code), expires, int(export), name))
    con.commit()
    return {'ok': True, 'name': name, 'code': code, 'expires_at': expires, 'export': export}


def invite_redeem(con):
    """The bot found an invitation code: the person becomes the client's owner."""
    data = read_json()
    code = str(data.get('code', ''))
    telegram = str(data.get('telegram_id', ''))
    if not INVITE_RE.fullmatch(code) or not re.fullmatch(r'[1-9][0-9]{2,14}', telegram):
        raise ValueError('Invalid invitation')
    row = con.execute('SELECT name, invite_expires, invite_export FROM clients WHERE invite_hash=?',
                      (invite_digest(code),)).fetchone()
    if not row:
        return {'found': False}
    if not row['invite_expires'] or datetime.fromisoformat(row['invite_expires']) <= utc_now():
        con.execute("UPDATE clients SET invite_hash='', invite_expires='', invite_export=0 WHERE name=?", (row['name'],))
        con.commit()
        return {'found': False, 'expired': True}
    # Single use: the code is gone before the answer leaves.
    con.execute("""UPDATE clients SET telegram_id=?, owner_export=?, invite_hash='', invite_expires='', invite_export=0
                   WHERE name=?""", (telegram, int(row['invite_export']), row['name']))
    con.commit()
    return {'found': True, 'name': row['name'], 'export': bool(row['invite_export'])}


