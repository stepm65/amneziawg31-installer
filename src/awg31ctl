def clients_add_batch(con):
    """Create PREFIX-01 ... PREFIX-NN with the same limits: one transaction, one peer sync."""
    data = read_json()
    prefix = str(data.get('prefix', '')).strip()
    try: count = int(data.get('count', 0)); start = int(data.get('start', 1))
    except (TypeError, ValueError): raise ValueError('Количество и начальный номер должны быть числами') from None
    if not 1 <= count <= 50: raise ValueError('За один раз можно создать от 1 до 50 клиентов')
    if not 0 <= start <= 9999: raise ValueError('Начальный номер: от 0 до 9999')
    width = max(2, len(str(start + count - 1)))
    names = [f'{prefix}-{number:0{width}d}' for number in range(start, start + count)]
    if any(not NAME_RE.fullmatch(name) for name in names):
        raise ValueError('Префикс: латиница, цифры, -, _; имя с номером не длиннее 32 символов')
    existing = {row[0] for row in con.execute('SELECT name FROM clients')}
    clash = sorted(set(names) & existing)
    if clash: raise ValueError('Уже существует: ' + ', '.join(clash[:5]))
    cfg = get_settings(con)
    shared = {k: v for k, v in data.items() if k in ('comment','expires_at','traffic_limit_bytes','speed_limit_mbit','speed_up_mbit',
                                                     'quota_period','i_enabled','i1','i2','i3','i4','i5')}
    peers = [insert_client(con, cfg, name, shared) for name in names]
    apply(cfg, con)
    rows = peer_rows(con)
    created = []
    for peer in peers:
        text = client_config(cfg, peer, rows)
        con.execute('UPDATE clients SET exported_hash=? WHERE name=?', (config_fingerprint(text), peer['name']))
        created.append({'name': peer['name'], 'ip': peer['ip'], 'config': text})
    con.commit()
    return {'ok': True, 'clients': created}


def config_fingerprint(text):
    return hashlib.sha256(text.encode()).hexdigest()


def clients_action(con, which):
    request = read_json()
    name = str(request.get('name',''))
    if not NAME_RE.fullmatch(name): raise ValueError('Неверное имя клиента')
    row = con.execute('SELECT * FROM clients WHERE name=?',(name,)).fetchone()
    if not row: raise ValueError('Клиент не найден')
    cfg = get_settings(con)
    if which == 'download':
        # Disabled peers remain editable/exportable to the authenticated admin.
        exported = client_config(cfg,dict(row),peer_rows(con))
        if request.get('mark') is True:
            # The admin took the file, QR or link: remember what was handed out,
            # so the panel can tell when the client needs a fresh configuration.
            con.execute('UPDATE clients SET exported_hash=? WHERE name=?',(config_fingerprint(exported),name))
            con.commit()
        return {'name':name,'ip':row['ip'],'config':exported,
                'link_config':client_config(cfg,dict(row),peer_rows(con),extra=False),
                'extra_lines':row['extra_lines'],
                'routed_subnets':row['routed_subnets'],
                'server_ip':cfg['server_ip'], 'subnet':cfg['subnet'],
                'client_public_key':row['public_key'],
                'i_enabled':bool(row['i_enabled']),
                'comment':row['comment'], 'expires_at':row['expires_at'],
                'traffic_limit_bytes':row['traffic_limit_bytes'], 'used_bytes':row['used_bytes'],
                'disabled_reason':row['disabled_reason'], 'telegram_id':row['telegram_id'],
                'owner_export':bool(row['owner_export']),
                'invite_expires':row['invite_expires'] if row['invite_hash'] and row['invite_expires']
                                 and datetime.fromisoformat(row['invite_expires']) > datetime.now(timezone.utc) else '',
                'invite_export':bool(row['invite_export']),
                'subscription':{'active':bool(row['sub_hash']),'created':row['sub_created'],'last_fetch':row['sub_last_fetch'],
                                'last_addr':row['sub_last_addr'],'fetches':row['sub_fetches']},
                'speed_limit_mbit':row['speed_limit_mbit'], 'speed_up_mbit':row['speed_up_mbit'], 'quota_period':row['quota_period'],
                'group_name':row['group_name'],
                **{key:row[key] for key in I_KEYS}}
    if which == 'enable':
        if row['expires_at'] and datetime.fromisoformat(row['expires_at']) <= datetime.now(timezone.utc):
            raise ValueError('Срок действия клиента истёк')
        if row['traffic_limit_bytes'] and row['used_bytes'] >= row['traffic_limit_bytes']:
            raise ValueError('Достигнут лимит трафика; увеличьте лимит')
        # A disabled peer can reserve a route while another peer is using it;
        # re-validate before enabling to prevent AllowedIPs collisions.
        parse_routes(row['routed_subnets'], cfg, con, owner=name)
    if which == 'delete':
        con.execute('DELETE FROM clients WHERE name=?',(name,))
        con.execute('DELETE FROM sessions WHERE client=?',(name,))     # a later client of the same name starts clean
    else: con.execute('UPDATE clients SET enabled=?, disabled_reason=? WHERE name=?',
                      (1 if which=='enable' else 0, '' if which=='enable' else 'manual', name))
    apply(cfg, con); con.commit()
    return {'ok':True,'name':name}




def clients_delete_batch(con):
    """Delete a validated selection in one transaction and one peer sync."""
    payload = read_json()
    names = payload.get('names')
    if (not isinstance(names, list) or not 1 <= len(names) <= 256
            or any(not isinstance(name, str) or not NAME_RE.fullmatch(name) for name in names)
            or len(set(names)) != len(names)):
        raise ValueError('Invalid client selection')
    found = {row[0] for row in con.execute(
        'SELECT name FROM clients WHERE name IN (' + ','.join('?' for _ in names) + ')', names)}
    if found != set(names):
        raise ValueError('One or more clients no longer exist')
    cfg = get_settings(con)
    con.executemany('DELETE FROM clients WHERE name=?', ((name,) for name in names))
    con.executemany('DELETE FROM sessions WHERE client=?', ((name,) for name in names))
