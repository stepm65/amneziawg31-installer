    con.commit()
    return {'ok': True, 'deleted': names}


def validate_client_address(raw, cfg, con, owner):
    try:
        address = ipaddress.ip_address(str(raw).strip())
    except ValueError:
        raise ValueError('Адрес клиента должен быть IPv4') from None
    if not isinstance(address, ipaddress.IPv4Address):
        raise ValueError('Адрес клиента должен быть IPv4')
    tunnel = parse_network(cfg['subnet'])
    if address not in tunnel or address in (tunnel.network_address, tunnel.broadcast_address):
        raise ValueError('Адрес должен быть свободным хостом в VPN-подсети')
    if address == ipaddress.ip_address(cfg['server_ip']):
        raise ValueError('Адрес зарезервирован сервером')
    conflict = con.execute('SELECT name FROM clients WHERE ip=? AND name<>?', (str(address), owner)).fetchone()
    if conflict:
        raise ValueError('Адрес уже назначен другому клиенту')
    return str(address)


def peer_backup(con, label):
    """A copy of server.conf and the database before a client edit."""
    backup_dir = Path(os.environ.get('AWG31_PEER_BACKUPS', '/var/backups/awg31-panel/peers'))
    backup = backup_dir / (datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S') + '-' + IFACE + '-' + label + '-' + secrets.token_hex(3))
    backup.mkdir(parents=True, mode=0o700, exist_ok=False)
    os.chmod(backup, 0o700)
    if CONF.exists():
        shutil.copy2(CONF, backup/'server.conf')
        os.chmod(backup/'server.conf', 0o600)
    with sqlite3.connect(backup/'state.sqlite3') as target:
        con.backup(target)
    os.chmod(backup/'state.sqlite3', 0o600)


def client_extra_update(con):
    """Set (or append) the same extra [Interface] lines on a selection of clients."""
    data = read_json()
    names = read_names(data)
    mode = str(data.get('mode', 'replace'))
    if mode not in ('replace', 'append'):
        raise ValueError('mode: replace или append')
    lines = validate_extra_lines(data.get('extra_lines', ''))
    rows = {row['name']: row['extra_lines'] for row in con.execute(
        'SELECT name, extra_lines FROM clients WHERE name IN (' + ','.join('?' for _ in names) + ')', names)}
    if set(rows) != set(names):
        raise ValueError('One or more clients no longer exist')
    updates = {}
    for name in names:
        current = rows[name]
        if mode == 'append' and current and lines:
            # Lines the client already has are dropped by the validation.
            try:
                new = validate_extra_lines(current + '\n' + lines)
            except ValueError as exc:
                raise ValueError(f'{name}: {exc}') from None
        else:
            new = current if mode == 'append' and not lines else lines
        if new != current:
            updates[name] = new
    if updates:
        peer_backup(con, 'extra-' + str(len(updates)))
        con.executemany('UPDATE clients SET extra_lines=? WHERE name=?', ((v, k) for k, v in updates.items()))
        con.commit()
    return {'ok': True, 'updated': sorted(updates), 'reimport_client': bool(updates)}


def read_names(data):
    names = data.get('names')
    if (not isinstance(names, list) or not 1 <= len(names) <= 256
            or any(not isinstance(name, str) or not NAME_RE.fullmatch(name) for name in names)
            or len(set(names)) != len(names)):
        raise ValueError('Invalid client selection')
    return names


def client_rekey(con):
    """A new key pair and PSK for one client; address, limits, owner and history stay."""
    data = read_json()
    name = str(data.get('name', ''))
    if not NAME_RE.fullmatch(name): raise ValueError('Неверное имя клиента')
