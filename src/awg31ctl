    return rotate(con, parts)


def rotate_schedule(con):
    data = read_json()
    try: days = int(data.get('days', 0))
    except (TypeError, ValueError): raise ValueError('Расписание: число дней') from None
    if days not in ROTATE_DAYS: raise ValueError('Расписание: 0, 1, 3, 7, 14 или 30 дней')
    parts = data.get('parts') or ['port', 'obfuscation']
    if not isinstance(parts, list) or not parts or not all(p in ROTATE_PARTS for p in parts):
        raise ValueError('parts: port, obfuscation, key')
    put_settings(con, {'rotate_days': days, 'rotate_parts': ','.join(p for p in ROTATE_PARTS if p in parts),
                       'rotate_since': datetime.now(timezone.utc).isoformat(timespec='seconds')})
    con.commit()
    return {'ok': True, 'days': days, 'parts': parts}


def rotation_due(cfg, now):
    try: days = int(cfg.get('rotate_days') or 0)
    except ValueError: return False
    if days <= 0: return False
    last = max(str(cfg.get('rotated_at') or ''), str(cfg.get('rotate_since') or ''))
    if not last: return True
    return (now - datetime.fromisoformat(last)).total_seconds() >= days * 86400


def mask_apply(con):
    """A masking profile: the same kind of I1 for every client (values built by the panel) and, if asked, its port."""
    data = read_json()
    profile = str(data.get('profile', ''))
    if profile not in MASK_PROFILES: raise ValueError('Неизвестный профиль маскировки')
    values = data.get('i1') or {}
    if not isinstance(values, dict) or len(values) > 4096: raise ValueError('i1: object name -> value')
    rows = {r['name'] for r in con.execute('SELECT name FROM clients')}
    if set(values) - rows: raise ValueError('One or more clients no longer exist')
    checked = {}
    for name, value in values.items():
        cps = validate_i_fields({'i_enabled': '1', 'i1': str(value)})
        checked[name] = cps['i1']
    cfg = get_settings(con)
    old_port = cfg['port']
    port = int(data.get('port') or 0)
    if port:
        port = valid_port(port)
        if port != old_port and port in used_udp_ports():
            raise ValueError(f'UDP-порт {port} уже занят на сервере')
    settings_backup(con, 'mask')
    con.executemany('UPDATE clients SET i_enabled=1, i1=? WHERE name=?', [(v, k) for k, v in checked.items()])
    stored = {'mask_profile': profile, 'mask_i1': ''}
    if profile == 'custom':
        if not str(data.get('custom_i1', '')).strip(): raise ValueError('Свой профиль: укажите пакет I1')
        own = validate_i_fields({'i_enabled': '1', 'i1': str(data.get('custom_i1', ''))})['i1']
        if any(v != own for v in checked.values()): raise ValueError('Свой профиль: один пакет I1 для всех клиентов')
        stored['mask_i1'] = own
    if port: stored['port'] = port
    put_settings(con, stored)
    cfg = get_settings(con)
    if port and port != old_port:
        apply(cfg, con, restart=True)
    con.commit()
    firewall = host_firewall_port(cfg['port'], old_port) if port else ''
    return {'ok': True, 'profile': profile, 'updated': sorted(checked), 'port': cfg['port'], 'old_port': old_port,
            'firewall': firewall, 'reimport_clients': bool(checked) or port != old_port}


def packet_probe(con):
    return probe_port(get_settings(con), read_json())


def probe_port(cfg, data):
    """Watch the server's UDP port for a few seconds: do client packets arrive, and does the server answer?"""
    import socket
    import struct
    seconds = min(30, max(5, int(data.get('seconds', 15) or 15)))
    port = cfg['port']
    masking = logging_settings()['masking']
    sock = socket.socket(socket.AF_PACKET, socket.SOCK_DGRAM, socket.ntohs(0x0003))
    sock.settimeout(0.5)
    deadline = _time.monotonic() + seconds
    incoming, outgoing, sizes, sources = 0, 0, {}, {}
    try:
        while _time.monotonic() < deadline:
            try:
                packet, address = sock.recvfrom(65535)
            except socket.timeout:
                continue
            proto, kind = address[1], address[2]
            if proto == 0x0800 and len(packet) >= 20 and packet[9] == 17:
                header = (packet[0] & 0x0F) * 4
                if len(packet) < header + 8: continue
                src = socket.inet_ntop(socket.AF_INET, packet[12:16])
                sport, dport, length = struct.unpack('!HHH', packet[header:header + 6])
            elif proto == 0x86DD and len(packet) >= 48 and packet[6] == 17:
                src = '[' + socket.inet_ntop(socket.AF_INET6, packet[8:24]) + ']'
                sport, dport, length = struct.unpack('!HHH', packet[40:46])
            else:
                continue
            payload = max(0, length - 8)
            if kind == 4 and sport == port:            # PACKET_OUTGOING: the server answers
                outgoing += 1
            elif kind != 4 and dport == port:
                incoming += 1
                sizes[payload] = sizes.get(payload, 0) + 1
                who = mask_endpoint(f'{src}:{sport}', masking) or 'hidden'
                sources[who] = sources.get(who, 0) + 1
    finally:
        sock.close()
    return {'ok': True, 'interface': IFACE, 'port': port, 'seconds': seconds, 'incoming': incoming, 'outgoing': outgoing,
            'sources': sorted(sources.items(), key=lambda x: -x[1])[:10],
            'sizes': sorted(sizes.items(), key=lambda x: -x[1])[:12],
            'expected_init': 148 + int(cfg['S1']), 'junk': [int(cfg['Jmin']), int(cfg['Jmax'])]}


MOVE_KEEP = ('name', 'private_key', 'public_key', 'psk', 'enabled', 'created_at', 'routed_subnets', 'i_enabled',
             *I_KEYS, 'extra_lines', 'comment', 'expires_at', 'traffic_limit_bytes', 'used_bytes', 'disabled_reason',
