def insert_client(con, cfg, name, data, routes=''):
    used = {x['ip'] for x in peer_rows(con)}
    net = parse_network(cfg['subnet'])
    address = next((str(h) for h in list(net.hosts())[1:] if str(h) not in used), None)
    if address is None: raise ValueError('Свободных адресов нет')
    private = keygen(); public = pubkey(private); psk = pskgen()
    cps = validate_i_fields(data)
    policy = validate_policy(data)
    con.execute('''INSERT INTO clients
        (name, ip, private_key, public_key, psk, enabled, created_at,
         routed_subnets, i_enabled, i1, i2, i3, i4, i5, comment, expires_at, traffic_limit_bytes, telegram_id, owner_export,
         speed_limit_mbit, speed_up_mbit, quota_period, quota_month, group_name)
         VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)''',
        (name,address,private,public,psk,1,datetime.now(timezone.utc).isoformat(),
         routes,cps['i_enabled'], *(cps[k] for k in I_KEYS),
         policy['comment'],policy['expires_at'],policy['traffic_limit_bytes'],policy['telegram_id'],policy['owner_export'],
         policy['speed_limit_mbit'],policy['speed_up_mbit'],policy['quota_period'],
         datetime.now(timezone.utc).strftime('%Y-%m') if policy['quota_period'] else '', policy['group_name']))
    return {'name':name,'private_key':private,'ip':address,'psk':psk,**cps}


